# Copy to .env. These settings are read from the file, not process overrides.
# Assigned application ports: 9000 and 9001 (application/API range 9000-9019).
MADRASI_PORT=9000
MADRASI_PATH=/madrasi/
MADRASI_REFERENCE_PORT=9001
MADRASI_REFERENCE_PATH=/madrasi/reference/
MADRASI_PUBLIC_ORIGIN=https://example.invalid
