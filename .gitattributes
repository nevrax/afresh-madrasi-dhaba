# Preserve exact exported bytes so catalogue checksums survive checkout.
assets/** -text

# Native source and documentation use stable line endings.
src/** text eol=lf
development/** text eol=lf
scripts/** text eol=lf
tools/** text eol=lf
docs/** text eol=lf
docs/media/*.jpg -text
README.md text eol=lf
*.html text eol=lf
package.json text eol=lf
tsconfig.json text eol=lf
*.cmd text eol=crlf

# Preserve the generated distribution bytes, including embedded resources.
dist/** -text whitespace=cr-at-eol
